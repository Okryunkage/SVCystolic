The module instance information can be found in project's XXX(project_name).gen/sources_1/ip/bram(instance_name)/bram.veo file.

##############################
##          Example         ##
##############################
bram your_instance_name (
  .clka(clka),    // input wire clka
  .ena(ena),      // input wire ena
  .wea(wea),      // input wire [0 : 0] wea
  .addra(addra),  // input wire [17 : 0] addra
  .dina(dina),    // input wire [63 : 0] dina
  .clkb(clkb),    // input wire clkb
  .enb(enb),      // input wire enb
  .addrb(addrb),  // input wire [17 : 0] addrb
  .doutb(doutb)  // output wire [63 : 0] doutb
);